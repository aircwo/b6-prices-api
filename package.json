{
  "name": "b6-prices",
  "version": "1.0.0",
  "main": "dist/index.ts",
  "scripts": {
    "clean": "node -e \"if (require('fs').existsSync('dist')) require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "ncc build src/index.ts -m --license ./license.txt -a",
    "start": "node dist/index.js",
    "test": "jest --config config/jest.config.ts",
    "test:coverage": "jest --config config/jest.config.ts --coverage",
    "eslint": "eslint . --config config/eslint.config.mjs",
    "eslint:fix": "eslint . --fix --config config/eslint.config.mjs",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm migration:run -- -d src/core/config/database.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d src/core/config/database.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [],
  "author": "aircwo",
  "license": "BSL-1.0",
  "description": "A Node API for tracking product prices through price alerts.",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "dotenv": "^16.4.7",
    "eslint-plugin-prettier": "^5.2.6",
    "fastify": "^5.2.2",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.23.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
